# Copy to .env and fill in your own values.
# Speechmatics real-time API token
SPEECHMATICS_API_KEY=
# Real-time WebSocket URL for your region, e.g. wss://eu2.rt.speechmatics.com/v2
SPEECHMATICS_URL=
# Gemini API key (used by /generate_summary)
GEMINI_API_KEY=
# Redis URL used to share audience rooms across Vercel Function instances.
# Required on Vercel (e.g. Upstash Redis from the Vercel Marketplace, rediss://...).
# Leave empty for local development with a single uvicorn process.
REDIS_URL=
# Optional. If set, /generate_summary requires an X-API-Key header.
APP_API_KEY=
