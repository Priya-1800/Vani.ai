# Copy to .env and fill in your own values.
# Speechmatics real-time API token
SPEECHMATICS_API_KEY=
# Real-time WebSocket URL for your region, e.g. wss://eu2.rt.speechmatics.com/v2
SPEECHMATICS_URL=
# Gemini API key (used by /generate_summary)
GEMINI_API_KEY=
# Optional. If set, /generate_summary requires an X-API-Key header.
APP_API_KEY=
